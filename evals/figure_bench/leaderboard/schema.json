{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blaiszik/mintfig/evals/figure_bench/leaderboard/schema.json",
  "title": "figure-bench v0.1 Leaderboard Submission",
  "description": "Schema for open leaderboard entries in figure-bench v0.1. Aggregate scores must match the per_task breakdown within rounding tolerance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "date",
    "team",
    "model",
    "library",
    "skill_or_prompt",
    "hook_enabled",
    "split",
    "task_count",
    "scores",
    "per_task",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$",
      "description": "Unique lowercase slug identifying this submission."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO-8601 date (YYYY-MM-DD) when the benchmark run completed."
    },
    "team": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Model name/version used by the agent or author (e.g. 'Claude Sonnet 5.5', 'GPT-5', 'Gemini 2.5 Pro', 'human')."
    },
    "library": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Primary plotting library or stack (e.g. mintfig, matplotlib, seaborn, altair, plotly, plotnine, ggplot2, d3, vega-lite, bokeh, other)."
    },
    "skill_or_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Skill bundle, system prompt, or arm instructions provided to the agent."
    },
    "hook_enabled": {
      "type": "boolean",
      "description": "Whether automated figure-check feedback (mint.check, neutral audit, or custom verifier hook) was enabled during generation."
    },
    "split": {
      "type": "string",
      "enum": ["all", "dev", "public-test", "heldout", "v0.1-initial-15"]
    },
    "work_in_progress": {
      "type": "boolean",
      "description": "True when reporting preliminary or subset v0.1 results (such as the initial 15-task baseline)."
    },
    "task_count": {
      "type": "integer",
      "minimum": 1
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composite",
        "visual_quality",
        "claim_accuracy",
        "uncertainty_calibration",
        "reader_score",
        "delivery_rate",
        "median_seconds"
      ],
      "properties": {
        "composite": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "visual_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "claim_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "uncertainty_calibration": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "reader_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "delivery_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "median_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "per_task": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "track",
          "split",
          "passed",
          "visual_quality",
          "claim_accuracy",
          "uncertainty_calibration",
          "reader_score",
          "delivery",
          "composite",
          "seconds"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
          },
          "track": {
            "type": "string",
            "enum": [
              "science_uncertainty",
              "swe_coding",
              "epistemic_traps",
              "multiturn_edit",
              "multi_surface",
              "byo_repair"
            ]
          },
          "split": {
            "type": "string",
            "enum": ["dev", "public-test", "heldout"]
          },
          "passed": {
            "type": "boolean"
          },
          "visual_quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "claim_accuracy": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "uncertainty_calibration": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "reader_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "delivery": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "composite": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "seconds": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "failed_checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "takeaway": {
            "type": "string"
          },
          "figure_path": {
            "type": ["string", "null"]
          },
          "display_width_px": {
            "type": "integer",
            "minimum": 100,
            "maximum": 4096
          },
          "timing": {
            "type": ["object", "null"],
            "description": "Optional detailed per-task timing breakdown (seconds_to_pass, seconds_total, time_to_first_submit_s, total_think_s, total_render_s, per_attempt, agent_cli)."
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "bench_version",
        "reproduce_command"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "bench_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "reproduce_command": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "source_report": {
          "type": "string",
          "maxLength": 240
        },
        "first_submission_clean_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "timing_summary": {
          "type": ["object", "null"],
          "description": "Optional aggregate timing distribution across tasks (min/p25/median/mean/p75/p90/p95/max/total)."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "artifacts_dir": {
      "type": ["string", "null"],
      "description": "Optional directory (relative to submission file or repo root) containing rendered task PNGs."
    }
  }
}
